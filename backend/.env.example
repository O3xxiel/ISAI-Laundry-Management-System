# Neon Postgres — DATABASE_URL usa el pooler (para la app), DIRECT_URL es la conexión directa (para migraciones)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/isai_laundry?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/isai_laundry?sslmode=require"

# Secreto para firmar los JWT de sesión (usar un valor largo y aleatorio en producción)
JWT_SECRET="change-me"
# Origen permitido para CORS con cookies
FRONTEND_URL="http://localhost:5173"
